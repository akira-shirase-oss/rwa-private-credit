# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/rwacredit/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/rwacredit-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/rwacredit-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# RWACREDIT_LISTEN=127.0.0.1:63250
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# RWACREDIT_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/rwacredit.service) less the pool and some headroom.
# RWACREDIT_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# RWACREDIT_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# RWACREDIT_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# RWACREDIT_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# RWACREDIT_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# RWACREDIT_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/rwacredit-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# RWACREDIT_REQUEST_TIMEOUT_MS=5000
# RWACREDIT_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# RWACREDIT_MAX_IN_FLIGHT=64

# --- Database (crates/rwacredit-db) ------------------------------------------------------
# RWACREDIT_DB_MAX_CONNECTIONS=16
# RWACREDIT_DB_ACQUIRE_TIMEOUT_MS=2000
# RWACREDIT_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# RWACREDIT_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# RWACREDIT_STARTUP_TIMEOUT_MS=30000

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least RWACREDIT_ERROR_MIN_REQUESTS were answered.
# RWACREDIT_ERROR_RATE_PERMILLE=50
# RWACREDIT_ERROR_MIN_REQUESTS=20
# RWACREDIT_LOG=info
# json for journald; text for a terminal.
# RWACREDIT_LOG_FORMAT=json

# --- Accounts (crates/rwacredit-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# RWACREDIT_SMTP_RELAY=
# RWACREDIT_MAIL_FROM=noreply@rwa-private-credit.invalid
# Where links in emails point.
# RWACREDIT_PUBLIC_URL=http://127.0.0.1:63250
# RWACREDIT_COOKIE_SECURE=true
# RWACREDIT_SESSION_TTL_S=604800
# RWACREDIT_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# RWACREDIT_TRUSTED_PROXIES=
# RWACREDIT_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# RWACREDIT_PLAN_MAX_MEMBERS=10
# RWACREDIT_PLAN_MAX_TOKENS=10
# RWACREDIT_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/rwacredit/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role rwacredit_app
#   migration-database-url  rwacreditctl migrate, digests, fingerprint, prune-events (rwacredit_owner)
#   admin-database-url      rwacreditctl bootstrap only
#   owner-password          rwacreditctl bootstrap only
#   app-password            rwacreditctl bootstrap only
# RWACREDIT_DATABASE_URL_FILE=/etc/rwacredit/credentials/database-url
# RWACREDIT_MIGRATION_DATABASE_URL_FILE=/etc/rwacredit/credentials/migration-database-url
# RWACREDIT_ADMIN_DATABASE_URL_FILE=/etc/rwacredit/credentials/admin-database-url
# RWACREDIT_OWNER_PASSWORD_FILE=/etc/rwacredit/credentials/owner-password
# RWACREDIT_APP_PASSWORD_FILE=/etc/rwacredit/credentials/app-password
